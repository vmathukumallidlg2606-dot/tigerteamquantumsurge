# Optional: Firebase Admin SDK credentials for production persistence.
# Without these, the app uses local file storage (local_data/users.json).
#
# Option 1 - path to your downloaded service account JSON:
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
#
# Option 2 - paste the entire JSON on one line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
